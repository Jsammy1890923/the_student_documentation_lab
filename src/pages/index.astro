---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TheStudentDocumentationLab™ | Administrative Records System</title>
</head>
<body class="min-h-full bg-slate-950 text-slate-100 antialiased flex flex-col justify-between selection:bg-red-600 selection:text-white">

  <!-- ==================== 1. HEADER & TOP NAVIGATION ==================== -->
  <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Identity -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-red-600 flex items-center justify-center font-bold text-xl text-white shadow-lg shadow-red-600/30">
          ⚖️
        </div>
        <div>
          <span class="text-lg font-black tracking-tight text-white block leading-tight">
            TheStudentDocumentationLab<span class="text-red-500">™</span>
          </span>
          <span class="text-[10px] font-mono text-slate-400 block tracking-wider uppercase">
            ADMINISTRATIVE RECORDS SYSTEM
          </span>
        </div>
      </div>

      <!-- 3 Dedicated Blog Navigation Portals -->
      <nav aria-label="Primary Navigation" class="flex items-center space-x-2 overflow-x-auto py-2">
        
        <!-- Portal 1: Main Feed -->
        <a 
          href="/blog" 
          class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-200 hover:text-white hover:bg-slate-800/80 transition-all flex items-center space-x-1.5 sm:space-x-2 border border-slate-800 hover:border-slate-700 whitespace-nowrap"
        >
          <span>📖</span>
          <span>Main Forensic Feed</span>
        </a>

        <!-- Portal 2: Neurodiverse Branch -->
        <a 
          href="/neurodiverse" 
          class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold text-purple-300 bg-purple-950/40 hover:bg-purple-900/60 border border-purple-800/50 hover:border-purple-600 transition-all flex items-center space-x-1.5 sm:space-x-2 shadow-sm whitespace-nowrap"
        >
          <span>🧠</span>
          <span>Neurodiverse / ADA 504</span>
        </a>

        <!-- Portal 3: International Branch -->
        <a 
          href="/international" 
          class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold text-blue-300 bg-blue-950/40 hover:bg-blue-900/60 border border-blue-800/50 hover:border-blue-600 transition-all flex items-center space-x-1.5 sm:space-x-2 shadow-sm whitespace-nowrap"
        >
          <span>🌐</span>
          <span>International / F-1 Hub</span>
        </a>

      </nav>

      <!-- Header Conversion Button -->
      <div class="hidden sm:flex items-center space-x-3">
        <a 
          href="https://payhip.com/buy?link=icTVm" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-4 py-2 rounded-lg text-xs font-bold text-white bg-red-600 hover:bg-red-500 transition-all shadow-md shadow-red-600/20"
        >
          Emergency Kit ($27)
        </a>
      </div>

    </div>
  </header>

  <!-- ==================== 2. EMERGENCY TRIAGE HERO BANNER ==================== -->
  <main id="main-content" class="flex-grow">
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-900 pt-12 pb-16 border-b border-slate-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        
        <!-- Red Zone Alert Badge -->
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-red-950/80 border border-red-800/80 text-red-400 text-xs font-mono font-semibold uppercase tracking-wider mb-6 animate-pulse">
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          <span>🚨 Emergency Triage: Red Zone (0–48 Hours)</span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
          Do Not Send an Emotional Apology.<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-amber-400 to-red-400">
            Shift to Administrative Proof.
          </span>
        </h1>

        <!-- Value Statement -->
        <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto mb-8 leading-relaxed">
          Hitting send on a frantic email legally destroys your credibility before a hearing begins. 
          Universities operate under the <strong>51% Preponderance of Evidence standard</strong>. 
          Halt the inquiry today with unalterable document metadata and statutory FERPA discovery requests.
        </p>

        <!-- Conversion Action Cards (2-Column Hero Actions) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
          
          <!-- Payhip Conversion ($27) -->
          <a 
            href="https://payhip.com/buy?link=icTVm" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-4 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold text-sm shadow-xl shadow-red-900/30 transition-all flex flex-col justify-center items-center group border border-red-500/30"
          >
            <span class="text-lg mb-1">📥 Download 24-Hour Kit</span>
            <span class="text-xs font-mono text-red-200 font-normal">($27 Complete Triage Suite) &rarr;</span>
          </a>

          <!-- Media Walkthrough -->
          <a 
            href="https://www.youtube.com/watch?v=Ks9nbp74aJE" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-4 rounded-xl bg-slate-800 hover:bg-slate-700/80 text-blue-400 font-bold text-sm border border-blue-500/40 hover:border-blue-400 transition-all flex flex-col justify-center items-center group shadow-md"
          >
            <span class="text-lg mb-1">▶️ Watch Defense Guide</span>
            <span class="text-xs font-mono text-blue-300/80 font-normal">(YouTube Walkthrough) &nearr;</span>
          </a>

        </div>

      </div>
    </section>

    <!-- ==================== 3. THREE DEMOGRAPHIC PORTALS GRID ==================== -->
    <section class="py-16 bg-slate-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Select Your Specialized Defense Branch
          </h2>
          <p class="text-sm text-slate-400 mt-2">
            Tailored forensic frameworks for specific student demographic requirements
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Card 1: Main Blog Portal -->
          <div class="bg-slate-900/90 rounded-2xl p-6 border border-slate-800 hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-red-950/80 border border-red-800/80 flex items-center justify-center text-2xl mb-4">
                📖
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Main Academic Line</h3>
              <p class="text-xs text-slate-400 mb-4 leading-relaxed">
                Designed for standard AI plagiarism false flags (Turnitin, Copyleaks), Canvas window-blur logs, and professor gradebook shock.
              </p>
              <ul class="text-xs text-slate-300 space-y-2 mb-6 font-mono">
                <li class="flex items-center">✔ Turnitin Asterisk (*%) Defense</li>
                <li class="flex items-center">✔ FERPA 34 CFR § 99.10 Discovery</li>
                <li class="flex items-center">✔ Keystroke & Revision Exports</li>
              </ul>
            </div>
            <a 
              href="/blog" 
              class="w-full py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold text-center border border-slate-700 transition-all block"
            >
              Explore Main Blog Feed &rarr;
            </a>
          </div>

          <!-- Card 2: Neurodiverse Branch -->
          <div class="bg-slate-900/90 rounded-2xl p-6 border border-purple-900/40 hover:border-purple-700/60 transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-purple-950/80 border border-purple-800/80 flex items-center justify-center text-2xl mb-4">
                🧠
              </div>
              <h3 class="text-xl font-bold text-purple-200 mb-2">Neurodiverse & ADA 504</h3>
              <p class="text-xs text-purple-300/70 mb-4 leading-relaxed">
                Protecting ADHD, Autistic, and Dyslexic scholars whose formulaic cognitive scaffolding is misidentified as AI burstiness.
              </p>
              <ul class="text-xs text-purple-200/80 space-y-2 mb-6 font-mono">
                <li class="flex items-center">✔ Stylometric Baseline Vector</li>
                <li class="flex items-center">✔ OAC Accommodation Disputes</li>
                <li class="flex items-center">✔ Bionic Focus Reading Mode</li>
              </ul>
            </div>
            <a 
              href="/neurodiverse" 
              class="w-full py-2.5 rounded-lg bg-purple-950 hover:bg-purple-900 text-purple-200 text-xs font-bold text-center border border-purple-800 transition-all block"
            >
              Access Neurodiverse Hub &rarr;
            </a>
          </div>

          <!-- Card 3: International Branch -->
          <div class="bg-slate-900/90 rounded-2xl p-6 border border-blue-900/40 hover:border-blue-700/60 transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-blue-950/80 border border-blue-800/80 flex items-center justify-center text-2xl mb-4">
                🌐
              </div>
              <h3 class="text-xl font-bold text-blue-200 mb-2">International & F-1 Visa</h3>
              <p class="text-xs text-blue-300/70 mb-4 leading-relaxed">
                Preserving SEVIS status and I-20 records for international students facing high-stakes status crisis proceedings.
              </p>
              <ul class="text-xs text-blue-200/80 space-y-2 mb-6 font-mono">
                <li class="flex items-center">✔ 8 CFR § 214.2(f) SEVIS Stays</li>
                <li class="flex items-center">✔ Multilingual Drafting Trails</li>
                <li class="flex items-center">✔ Autocomplete Language UX</li>
              </ul>
            </div>
            <a 
              href="/international" 
              class="w-full py-2.5 rounded-lg bg-blue-950 hover:bg-blue-900 text-blue-200 text-xs font-bold text-center border border-blue-800 transition-all block"
            >
              Access Global Student Hub &rarr;
            </a>
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- ==================== 4. FOOTER & HIGH-CONTRAST LEGAL DISCLAIMER ==================== -->
  <footer class="bg-slate-950 text-slate-300 text-xs border-t border-slate-800 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
        <div>
          <span class="text-sm font-bold text-white block mb-3">TheStudentDocumentationLab™</span>
          <p class="text-slate-400 leading-relaxed">
            Administrative record-keeping systems and evidence structuring frameworks for academic defense.
          </p>
        </div>
        <div>
          <span class="text-sm font-bold text-white block mb-3">System Navigation</span>
          <ul class="space-y-2 font-mono">
            <li><a href="/blog" class="hover:text-white">Main Forensic Feed</a></li>
            <li><a href="/neurodiverse" class="hover:text-white">Neurodiverse Branch</a></li>
            <li><a href="/international" class="hover:text-white">International Hub</a></li>
          </ul>
        </div>
        <div>
          <span class="text-sm font-bold text-white block mb-3">Statutory References</span>
          <ul class="space-y-2 font-mono">
            <li><span>34 CFR § 99.10 (FERPA Discovery)</span></li>
            <li><span>Section 504 / Title II ADA</span></li>
            <li><span>8 CFR § 214.2(f) (SEVIS Stays)</span></li>
          </ul>
        </div>
        <div>
          <span class="text-sm font-bold text-white block mb-3">Administrative Architecture</span>
          <p class="text-slate-400 leading-relaxed font-mono">
            MMDDYY_HHMM 17-Department Folder Tree Specification Enabled.
          </p>
        </div>
      </div>

      <!-- Bright, High-Contrast Disclaimer Callout -->
      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800 text-center leading-relaxed shadow-lg">
        <p class="text-white text-xs sm:text-sm font-normal leading-relaxed mb-3">
          <strong class="text-red-400 font-bold tracking-wide uppercase">Disclaimer & Statement of Purpose:</strong> 
          TheStudentDocumentationLab™ provides administrative record-keeping systems, evidence structuring tools, and educational self-help frameworks. We are not a law firm, nor do we provide legal advice or guaranteed academic outcomes. What we offer is administrative clarity: curated procedural data and organizational tools to help you articulate your rights.
        </p>
        <p class="text-slate-400 font-mono text-[11px]">&copy; 2026 TheStudentDocumentationLab™. All rights reserved.</p>
      </div>

    </div>
  </footer>

</body>
</html>