---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TheStudentDocumentationLab™ | Administrative Records System</title>
</head>
<body class="min-h-full bg-slate-950 text-slate-100 antialiased flex flex-col justify-between selection:bg-red-600 selection:text-white">

  <!-- ==================== 1. WELCOME HEADER (CLEAN BRAND ONLY) ==================== -->
  <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Identity & Monogram -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-red-600 flex items-center justify-center font-bold text-xl text-white shadow-lg shadow-red-600/30">
          ⚖️
        </div>
        <div>
          <span class="text-lg font-black tracking-tight text-white block leading-tight">
            TheStudentDocumentationLab<span class="text-red-500">™</span>
          </span>
          <span class="text-[10px] font-mono text-slate-400 block tracking-wider uppercase">
            ADMINISTRATIVE RECORDS SYSTEM
          </span>
        </div>
      </div>

      <!-- Triage Status Marker -->
      <div class="flex items-center space-x-2 text-xs font-mono text-emerald-400 bg-emerald-950/50 border border-emerald-800/60 px-3 py-1.5 rounded-full">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="hidden sm:inline">STATUS:</span> <span>TRIAGE PORTAL ACTIVE</span>
      </div>

    </div>
  </header>

  <!-- ==================== 2. WELCOME & ADMINISTRATIVE DISCLAIMER ==================== -->
  <main id="main-content" class="flex-grow">
    <section class="relative overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-900 pt-14 pb-14 border-b border-slate-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        
        <p class="text-xs font-mono text-slate-400 uppercase tracking-widest mb-3">
          WELCOME TO THE STUDENT DOCUMENTATION LAB™
        </p>

        <!-- Core Directive -->
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
          Stop Panicking.<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-amber-400 to-red-400">
            Start Documenting.
          </span>
        </h1>

        <!-- Proof Standard Thesis -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
          Universities operate on administrative proof under the <strong>51% Preponderance of Evidence standard</strong>. 
          Emotional pleas fail; unalterable document metadata succeeds.
        </p>

        <!-- Prominent Administrative Disclaimer Box -->
        <div class="p-6 rounded-xl bg-slate-900/90 border border-slate-800 text-left leading-relaxed shadow-lg">
          <p class="text-slate-100 text-xs sm:text-sm font-medium">
            <strong class="text-red-400 font-bold uppercase tracking-wide">ADMINISTRATIVE DISCLAIMER & NOTICE:</strong> 
            TheStudentDocumentationLab™ provides administrative record-keeping systems, evidence structuring tools, and educational self-help frameworks. We are not a law firm, nor do we offer formal legal representation or guaranteed outcomes. What we provide is administrative clarity: curated procedural data to help you articulate your rights under university bylaws.
          </p>
        </div>

      </div>
    </section>

    <!-- ==================== 3. 4 COLOR-CODED PROFILE CARDS ==================== -->
    <section class="py-16 bg-slate-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-12">
          <span class="text-xs font-mono text-red-400 uppercase tracking-widest block mb-2">
            STEP 1: SELECT YOUR DEFENSE BRANCH
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            What Type of Student Are You?
          </h2>
          <p class="text-sm text-slate-400 mt-2 max-w-2xl mx-auto">
            Select your academic profile below to enter your dedicated demographic portal containing your specialized Starter Kit, Blog Feed, and YouTube Video Walkthroughs:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- PROFILE 01: Standard Line -->
          <div class="bg-slate-900/90 rounded-2xl p-6 border border-slate-800 hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest block mb-1">PROFILE 01</span>
              <h3 class="text-xl font-bold text-white mb-2">Standard Line</h3>
              <p class="text-xs text-slate-400 mb-5 leading-relaxed">
                For general AI plagiarism false flags (Turnitin, Copyleaks), Canvas window-blur logs, and professor gradebook shock.
              </p>
              <ul class="text-xs text-slate-300 space-y-2 mb-6 font-mono">
                <li class="flex items-center">✔ Standard 24h Response Kit</li>
                <li class="flex items-center">✔ Main Forensic Blog Feed</li>
                <li class="flex items-center">✔ YouTube Walkthrough Video</li>
              </ul>
            </div>
            <a 
              href="/blog" 
              class="w-full py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold text-center border border-slate-700 transition-all block"
            >
              Select Standard Line &rarr;
            </a>
          </div>

          <!-- PROFILE 02: Neurodiverse / 504 -->
          <div class="bg-slate-900/90 rounded-2xl p-6 border border-purple-900/40 hover:border-purple-700/60 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-purple-400 uppercase tracking-widest block mb-1">PROFILE 02</span>
              <h3 class="text-xl font-bold text-purple-200 mb-2">Neurodiverse / 504</h3>
              <p class="text-xs text-purple-300/70 mb-5 leading-relaxed">
                For ADHD, Autistic, and Dyslexic scholars whose structured cognitive scaffolding was falsely flagged as low burstiness.
              </p>
              <ul class="text-xs text-purple-200/80 space-y-2 mb-6 font-mono">
                <li class="flex items-center">✔ Section 504 Accommodation Kit</li>
                <li class="flex items-center">✔ Neurodiverse Defense Feed</li>
                <li class="flex items-center">✔ ADA YouTube Walkthrough</li>
              </ul>
            </div>
            <a 
              href="/neurodiverse" 
              class="w-full py-2.5 rounded-lg bg-purple-950 hover:bg-purple-900 text-purple-200 text-xs font-bold text-center border border-purple-800 transition-all block"
            >
              Select ADA 504 Branch &rarr;
            </a>
          </div>

          <!-- PROFILE 03: International / F-1 -->
          <div class="bg-slate-900/90 rounded-2xl p-6 border border-blue-900/40 hover:border-blue-700/60 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-blue-400 uppercase tracking-widest block mb-1">PROFILE 03</span>
              <h3 class="text-xl font-bold text-blue-200 mb-2">International / F-1</h3>
              <p class="text-xs text-blue-300/70 mb-5 leading-relaxed">
                For international scholars protecting SEVIS status, I-20 validity, and overcoming Stanford ESL detector bias.
              </p>
              <ul class="text-xs text-blue-200/80 space-y-2 mb-6 font-mono">
                <li class="flex items-center">✔ 8 CFR § 214.2(f) SEVIS Hold Kit</li>
                <li class="flex items-center">✔ Global Student Defense Feed</li>
                <li class="flex items-center">✔ SEVIS YouTube Walkthrough</li>
              </ul>
            </div>
            <a 
              href="/international" 
              class="w-full py-2.5 rounded-lg bg-blue-950 hover:bg-blue-900 text-blue-200 text-xs font-bold text-center border border-blue-800 transition-all block"
            >
              Select Global Student Hub &rarr;
            </a>
          </div>

          <!-- PROFILE 04: Graduate & Med / Law -->
          <div class="bg-slate-900/90 rounded-2xl p-6 border border-amber-900/40 hover:border-amber-700/60 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-amber-400 uppercase tracking-widest block mb-1">PROFILE 04</span>
              <h3 class="text-xl font-bold text-amber-200 mb-2">Graduate & Med / Law</h3>
              <p class="text-xs text-amber-300/70 mb-5 leading-relaxed">
                For pre-med (AMCAS), pre-law, and PhD scholars protecting transcripts, thesis research, and professional standing.
              </p>
              <ul class="text-xs text-amber-200/80 space-y-2 mb-6 font-mono">
                <li class="flex items-center">✔ AMCAS / Bar High-Stakes Kit</li>
                <li class="flex items-center">✔ Graduate Defense Feed</li>
                <li class="flex items-center">✔ High-Stakes YouTube Video</li>
              </ul>
            </div>
            <a 
              href="/graduate" 
              class="w-full py-2.5 rounded-lg bg-amber-950 hover:bg-amber-900 text-amber-200 text-xs font-bold text-center border border-amber-800 transition-all block"
            >
              Select Graduate Hub &rarr;
            </a>
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- ==================== 4. FOOTER ==================== -->
  <footer class="bg-slate-950 text-slate-300 text-xs border-t border-slate-800 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="p-6 rounded-xl bg-slate-900 border border-slate-800 text-center leading-relaxed shadow-lg">
        <p class="text-white text-xs sm:text-sm font-normal leading-relaxed mb-3">
          <strong class="text-red-400 font-bold tracking-wide uppercase">TheStudentDocumentationLab™ ADMINISTRATIVE RECORDS SYSTEM NOT LEGAL ADVICE:</strong><br />
          TheStudentDocumentationLab™ provides administrative record-keeping systems, evidence structuring tools, and educational self-help frameworks. We are not a law firm, nor do we offer formal legal representation or guaranteed academic outcomes.
        </p>
        <p class="text-slate-400 font-mono text-[11px]">&copy; 2026 TheStudentDocumentationLab™. All rights reserved.</p>
      </div>

    </div>
  </footer>

  <Analytics />
</body>
</html>