---
// src/pages/index.astro - Vibrant Uplifting Triage Portal
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TheStudentDocumentationLab™ | Student Defense Organization System</title>
</head>
<body class="min-h-full bg-gradient-to-br from-sky-200 via-cyan-100 to-indigo-200 text-slate-900 antialiased flex flex-col justify-between selection:bg-yellow-300 selection:text-blue-900">

  <!-- ==================== 1. WELCOME HEADER ==================== -->
  <header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-sky-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Identity & Neon Tag -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-slate-900 border-2 border-[#00d8ff] flex items-center justify-center font-bold text-xl text-white shadow-md shadow-sky-500/30">
          ⚖️
        </div>
        <div>
          <span class="text-lg font-black tracking-tight block leading-tight">
            <span class="bg-[#ffff00] text-[#0040ff] px-2.5 py-0.5 rounded-md font-extrabold shadow-sm border border-yellow-300">TheStudentDocumentationLab</span><span class="text-[#0040ff] font-extrabold">™</span>
          </span>
          <span class="text-[10px] font-mono text-slate-600 block tracking-wider uppercase font-semibold">
            STUDENT DEFENSE ORGANIZATION SYSTEM
          </span>
        </div>
      </div>

      <!-- Triage Status Marker -->
      <div class="flex items-center space-x-2 text-xs font-mono text-emerald-900 bg-emerald-100 border border-emerald-300 px-3.5 py-1.5 rounded-full shadow-xs">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="hidden sm:inline font-bold">STATUS:</span> <span class="font-semibold">TRIAGE PORTAL ACTIVE</span>
      </div>

    </div>
  </header>

  <!-- ==================== 2. WELCOME & DISCLAIMER HERO ==================== -->
  <main id="main-content" class="flex-grow">
    <section class="relative overflow-hidden pt-14 pb-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        
        <p class="text-xs font-mono text-sky-900 font-bold uppercase tracking-widest mb-3">
          WELCOME TO THE STUDENT DOCUMENTATION LAB™
        </p>

        <!-- Core Directive -->
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6">
          Stop Panicking.<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-indigo-700 to-purple-800">
            Start Documenting.
          </span>
        </h1>

        <!-- Proof Standard Thesis -->
        <p class="text-base sm:text-lg text-slate-800 max-w-2xl mx-auto mb-8 leading-relaxed font-medium">
          Universities operate on administrative proof under the <strong class="text-slate-950 font-bold">51% Preponderance of Evidence standard</strong>. 
          Emotional pleas fail; unalterable document metadata succeeds.
        </p>

        <!-- Notice Box -->
        <div class="p-6 rounded-2xl bg-white/90 backdrop-blur-md border border-white text-left leading-relaxed shadow-lg shadow-sky-900/10">
          <p class="text-slate-800 text-xs sm:text-sm font-medium">
            <strong class="text-blue-700 font-bold uppercase tracking-wide">ADMINISTRATIVE DISCLAIMER & NOTICE:</strong> 
            TheStudentDocumentationLab™ provides administrative record-keeping systems, evidence structuring tools, and educational self-help frameworks. We are not a law firm, nor do we offer formal legal representation or guaranteed outcomes. What we provide is administrative clarity: curated procedural data to help you articulate your rights under university bylaws.
          </p>
        </div>

      </div>
    </section>

    <!-- ==================== 3. 4 REFINED EMPATHETIC DEFENSE CARDS ==================== -->
    <section class="py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-12">
          <span class="text-xs font-mono text-blue-800 font-bold uppercase tracking-widest block mb-2">
            STEP 1: SELECT YOUR DEFENSE BRANCH
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            What Type of Student Are You?
          </h2>
          <p class="text-sm text-slate-800 mt-2 max-w-2xl mx-auto font-medium">
            Select your academic situation below to enter your dedicated demographic portal containing your specialized Starter Kit, Blog Feed, and YouTube Video Walkthroughs:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- OPTION 1: General Coursework & Essay Defense -->
          <div class="bg-white/95 rounded-2xl p-6 border-2 border-sky-400 shadow-lg shadow-sky-900/10 hover:shadow-xl hover:border-sky-500 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-sky-700 font-bold uppercase tracking-widest block mb-1">PROFILE 01</span>
              <h3 class="text-xl font-black text-slate-900 mb-1.5 flex items-center gap-1.5">
                <span>🛡️</span> <span>General Coursework & Essay Defense</span>
              </h3>
              <p class="text-[11px] font-semibold text-sky-800 mb-3 leading-snug">
                For AI detector flags, essay plagiarism notices, and initial faculty emails.
              </p>
              <p class="text-xs text-slate-700 mb-4 leading-relaxed">
                <strong>Who It's For:</strong> Undergraduate and college students facing a false Turnitin or GPTZero AI score, a sudden plagiarism flag, or an email requesting a meeting about an assignment.
              </p>
              <div class="mb-6 pt-3 border-t border-sky-100">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500 block mb-2">What You Get:</span>
                <ul class="text-xs text-slate-800 space-y-1.5 font-medium">
                  <li class="flex items-start"><span class="text-sky-600 mr-1.5 font-bold">✔</span> 24-Hour Response Kit™</li>
                  <li class="flex items-start"><span class="text-sky-600 mr-1.5 font-bold">✔</span> Docs & Word History Guides</li>
                  <li class="flex items-start"><span class="text-sky-600 mr-1.5 font-bold">✔</span> Canvas Access Log Walkthroughs</li>
                  <li class="flex items-start"><span class="text-sky-600 mr-1.5 font-bold">✔</span> 3-Sentence Discovery Script</li>
                </ul>
              </div>
            </div>
            <a 
              href="/blog" 
              class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold text-center shadow-md shadow-blue-600/30 transition-all block"
            >
              Select Coursework Defense &rarr;
            </a>
          </div>

          <!-- OPTION 2: Neurodiverse & Accessibility Defense -->
          <div class="bg-white/95 rounded-2xl p-6 border-2 border-purple-400 shadow-lg shadow-purple-900/10 hover:shadow-xl hover:border-purple-500 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-purple-700 font-bold uppercase tracking-widest block mb-1">PROFILE 02</span>
              <h3 class="text-xl font-black text-purple-950 mb-1.5 flex items-center gap-1.5">
                <span>🧠</span> <span>Neurodiverse & Accommodation Defense</span>
              </h3>
              <p class="text-[11px] font-semibold text-purple-800 mb-3 leading-snug">
                For structured writing style flags, low-perplexity bias, or proctoring software alerts.
              </p>
              <p class="text-xs text-purple-950/85 mb-4 leading-relaxed">
                <strong>Who It's For:</strong> ADHD, Autistic, or neurodivergent students whose linear writing triggered a false AI flag, or who face Honorlock/Proctorio eye-gaze and inactivity flags.
              </p>
              <div class="mb-6 pt-3 border-t border-purple-100">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-purple-600 block mb-2">What You Get:</span>
                <ul class="text-xs text-purple-950 space-y-1.5 font-medium">
                  <li class="flex items-start"><span class="text-purple-600 mr-1.5 font-bold">✔</span> Section 504 / OAC Dispute Sheets</li>
                  <li class="flex items-start"><span class="text-purple-600 mr-1.5 font-bold">✔</span> Sensory Freeze Intake Protocols</li>
                  <li class="flex items-start"><span class="text-purple-600 mr-1.5 font-bold">✔</span> Proctoring Telemetry Rebuttals</li>
                  <li class="flex items-start"><span class="text-purple-600 mr-1.5 font-bold">✔</span> Stylometric Baseline Addendums</li>
                </ul>
              </div>
            </div>
            <a 
              href="/neurodiverse" 
              class="w-full py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold text-center shadow-md shadow-purple-600/30 transition-all block"
            >
              Select Neurodiverse Defense &rarr;
            </a>
          </div>

          <!-- OPTION 3: International Student & ESL Visa Defense -->
          <div class="bg-white/95 rounded-2xl p-6 border-2 border-teal-400 shadow-lg shadow-teal-900/10 hover:shadow-xl hover:border-teal-500 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-teal-700 font-bold uppercase tracking-widest block mb-1">PROFILE 03</span>
              <h3 class="text-xl font-black text-teal-950 mb-1.5 flex items-center gap-1.5">
                <span>🛂</span> <span>International Student & ESL Visa Defense</span>
              </h3>
              <p class="text-[11px] font-semibold text-teal-800 mb-3 leading-snug">
                For non-native English style bias, translation logs, and SEVIS status stays.
              </p>
              <p class="text-xs text-teal-950/85 mb-4 leading-relaxed">
                <strong>Who It's For:</strong> International exchange students and F-1 visa holders facing AI flags due to TOEFL constrained variance or needing to protect lawful status from premature SEVIS reporting.
              </p>
              <div class="mb-6 pt-3 border-t border-teal-100">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-teal-700 block mb-2">What You Get:</span>
                <ul class="text-xs text-teal-950 space-y-1.5 font-medium">
                  <li class="flex items-start"><span class="text-teal-600 mr-1.5 font-bold">✔</span> 8 CFR § 214.2(f) SEVIS Stay Petitions</li>
                  <li class="flex items-start"><span class="text-teal-600 mr-1.5 font-bold">✔</span> Stanford HAI Empirical Bias Dossier</li>
                  <li class="flex items-start"><span class="text-teal-600 mr-1.5 font-bold">✔</span> Multilingual Drafting Audit Logs</li>
                  <li class="flex items-start"><span class="text-teal-600 mr-1.5 font-bold">✔</span> DSO Notification Protocols</li>
                </ul>
              </div>
            </div>
            <a 
              href="/international" 
              class="w-full py-2.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white text-xs font-bold text-center shadow-md shadow-teal-600/30 transition-all block"
            >
              Select Visa Defense Hub &rarr;
            </a>
          </div>

          <!-- OPTION 4: Medical, Law & Graduate Student Defense -->
          <div class="bg-white/95 rounded-2xl p-6 border-2 border-amber-400 shadow-lg shadow-amber-900/10 hover:shadow-xl hover:border-amber-500 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-mono text-amber-700 font-bold uppercase tracking-widest block mb-1">PROFILE 04</span>
              <h3 class="text-xl font-black text-amber-950 mb-1.5 flex items-center gap-1.5">
                <span>🩺</span> <span>Medical, Law & Graduate Defense</span>
              </h3>
              <p class="text-[11px] font-semibold text-amber-800 mb-3 leading-snug">
                For thesis disputes, clinical logs, or accusations threatening professional licensing.
              </p>
              <p class="text-xs text-amber-950/85 mb-4 leading-relaxed">
                <strong>Who It's For:</strong> MA/PhD, pre-med (AMCAS), pre-law (LSAC), nursing, or pharmacy candidates where an integrity notation carries career-ending board disclosures or fitness risks.
              </p>
              <div class="mb-6 pt-3 border-t border-amber-100">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-amber-700 block mb-2">What You Get:</span>
                <ul class="text-xs text-amber-950 space-y-1.5 font-medium">
                  <li class="flex items-start"><span class="text-amber-600 mr-1.5 font-bold">✔</span> Transcript Protection Briefs</li>
                  <li class="flex items-start"><span class="text-amber-600 mr-1.5 font-bold">✔</span> Clinical/Lab Telemetry Templates</li>
                  <li class="flex items-start"><span class="text-amber-600 mr-1.5 font-bold">✔</span> STEM Code Provenance Frameworks</li>
                  <li class="flex items-start"><span class="text-amber-600 mr-1.5 font-bold">✔</span> 1-on-1 Document Triage Protocols</li>
                </ul>
              </div>
            </div>
            <a 
              href="/graduate" 
              class="w-full py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold text-center shadow-md shadow-amber-600/30 transition-all block"
            >
              Select Graduate Defense &rarr;
            </a>
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- ==================== 4. FOOTER ==================== -->
  <footer class="bg-white/80 backdrop-blur-md border-t border-sky-200 py-10 mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="p-6 rounded-2xl bg-white/90 border border-sky-200 text-center leading-relaxed shadow-sm">
        <p class="text-slate-800 text-xs sm:text-sm font-medium leading-relaxed mb-3">
          <strong class="text-blue-700 font-bold uppercase tracking-wide">TheStudentDocumentationLab™ ADMINISTRATIVE RECORDS SYSTEM NOT LEGAL ADVICE:</strong><br />
          TheStudentDocumentationLab™ provides administrative record-keeping systems, evidence structuring tools, and educational self-help frameworks. We are not a law firm, nor do we offer formal legal representation or guaranteed academic outcomes.
        </p>
        <p class="text-slate-600 font-mono text-[11px]">&copy; 2026 TheStudentDocumentationLab™. All rights reserved.</p>
      </div>

    </div>
  </footer>

  <Analytics />
</body>
</html>