---
// src/pages/international.astro
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>International & ESL Student Defense Hub</title>
  </head>
  <body class="min-h-screen bg-slate-900 text-slate-100 font-sans p-8">
    <div class="max-w-4xl mx-auto">
      <a href="/" class="text-sm text-blue-400 hover:underline mb-6 inline-block">← Back to Home</a>
      
      <header class="mb-8">
        <span class="text-blue-400 text-sm font-bold uppercase tracking-wider">Demographic Defense Portal</span>
        <h1 class="text-3xl font-black mt-2">International & F-1 Visa Student Hub</h1>
        <p class="text-slate-400 mt-2">
          Forensic guides, SEVIS stay petitions under 8 CFR § 214.2(f), and Stanford empirical detector bias resources.
        </p>
      </header>

      <section class="bg-slate-800/60 border border-slate-700 rounded-xl p-6">
        <h2 class="text-xl font-bold mb-2">Portal Active</h2>
        <p class="text-slate-300">
          Your International Student route is now connected and functioning properly.
        </p>
      </section>
    </div>
  </body>
</html>