---
// src/pages/blog/index.astro - Profile 01: Standard Academic Line Portal
import '../../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { getCollection } from 'astro:content';

let posts: any[] = [];
try {
  posts = (await getCollection('blog')) || [];
  posts.sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateB - dateA;
  });
} catch (e) {
  posts = [];
}
---

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Standard Line Portal & Forensic Feed | TheStudentDocumentationLab™</title>
</head>
<body class="min-h-full bg-gradient-to-br from-sky-200 via-cyan-100 to-indigo-200 text-slate-900 antialiased flex flex-col justify-between selection:bg-yellow-300 selection:text-blue-900">

  <!-- ==================== 1. TOP NAVIGATION ==================== -->
  <header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-sky-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Identity -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 rounded-xl bg-slate-900 border-2 border-[#00d8ff] flex items-center justify-center font-bold text-xl text-white shadow-md shadow-sky-500/30">
          ⚖️
        </div>
        <div>
          <span class="text-lg font-black tracking-tight block leading-tight">
            <span class="bg-[#ffff00] text-[#0040ff] px-2 py-0.5 rounded-md font-extrabold shadow-sm border border-yellow-300">TheStudentDocumentationLab</span><span class="text-[#0040ff] font-extrabold">™</span>
          </span>
          <span class="text-[10px] font-mono text-slate-600 block tracking-wider uppercase font-semibold">
            PROFILE 01: STANDARD LINE
          </span>
        </div>
      </a>

      <!-- Gateway Breadcrumbs / Profile Links -->
      <nav aria-label="Branch Navigation" class="flex items-center space-x-2 sm:space-x-3 text-xs font-semibold">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-white/80 hover:bg-white text-slate-700 border border-slate-200 transition-all shadow-xs">
          ← Gateway
        </a>
        <a href="/neurodiverse" class="hidden sm:inline-block px-3 py-1.5 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 transition-all">
          Neurodiverse
        </a>
        <a href="/international" class="hidden sm:inline-block px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200 transition-all">
          International
        </a>
        <a href="/graduate" class="hidden sm:inline-block px-3 py-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 transition-all">
          Graduate
        </a>
      </nav>

    </div>
  </header>

  <!-- ==================== 2. HUB HERO HEADER ==================== -->
  <main id="main-content" class="flex-grow">
    <section class="pt-12 pb-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <span class="inline-block text-xs font-mono font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-sky-100 text-blue-800 border border-sky-300 mb-4 shadow-xs">
          PROFILE 01: STANDARD ACADEMIC MISCONDUCT DEFENSE
        </span>

        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-4">
          Main Forensic Feed & <br class="hidden sm:inline" />
          <span class="bg-[#ffff00] text-[#0040ff] px-3 py-0.5 rounded-xl border border-yellow-300 inline-block mt-1">
            Rebuttal System
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-700 max-w-3xl mx-auto leading-relaxed font-medium">
          Procedural guides and evidence frameworks for Turnitin AI false positives, Canvas log inquiries, and Google Docs version history exports.
        </p>

      </div>
    </section>

    <!-- ==================== 3. VIDEO & STARTER KIT DUAL MODULE ==================== -->
    <section class="py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          
          <!-- Video Walkthrough Embed (7 Cols) -->
          <div class="lg:col-span-7 bg-white/95 backdrop-blur-md rounded-2xl p-6 border-2 border-sky-300 shadow-xl shadow-sky-900/10 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono font-bold uppercase text-blue-700 tracking-wider flex items-center gap-1.5">
                  <span>▶️</span> VIDEO WALKTHROUGH: 48-HOUR TECHNICAL REBUTTAL
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-100 text-sky-800 font-bold">HD STEP-BY-STEP</span>
              </div>
              <div class="aspect-video w-full rounded-xl overflow-hidden shadow-md border border-slate-200 bg-slate-950 mb-4">
                <iframe 
                  class="w-full h-full"
                  src="https://www.youtube.com/embed/Ks9nbp74aJE" 
                  title="YouTube video player" 
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen
                ></iframe>
              </div>
            </div>
            <p class="text-xs text-slate-600 font-medium leading-relaxed">
              <strong class="text-slate-900">Key Concept:</strong> Do not submit emotional written statements. Watch how to extract raw document metadata and file a formal FERPA 34 CFR § 99.10 record request before your first meeting.
            </p>
          </div>

          <!-- $27 Starter Kit Card (5 Cols) -->
          <div class="lg:col-span-5 bg-white/95 backdrop-blur-md rounded-2xl p-6 border-2 border-blue-500 shadow-xl shadow-blue-900/15 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-blue-600">OFFICIAL STARTER KIT</span>
                <span class="text-xs font-mono font-extrabold px-2.5 py-1 rounded-full bg-[#ffff00] text-[#0040ff] border border-yellow-300 shadow-xs">$27 USD</span>
              </div>
              <h2 class="text-2xl font-black text-slate-900 mb-3">
                Standard 24-Hour Emergency Response Kit
              </h2>
              <p class="text-xs text-slate-700 mb-5 leading-relaxed font-medium">
                Complete plug-and-play legal-tech template bundle. Includes the Turnitin Asterisk (*%) Rebuttal Script, Google Docs Revision History PDF Exporter, and FERPA 34 CFR § 99.10 Discovery Demand Letter.
              </p>
              <ul class="text-xs text-slate-800 space-y-2 mb-6 font-mono font-medium">
                <li class="flex items-center"><span class="text-blue-600 mr-2 font-bold">✔</span> Immediate Instant PDF Download</li>
                <li class="flex items-center"><span class="text-blue-600 mr-2 font-bold">✔</span> Admission-Neutral Drafting Lock</li>
                <li class="flex items-center"><span class="text-blue-600 mr-2 font-bold">✔</span> Preponderance of Evidence Standard Check</li>
              </ul>
            </div>
            
            <a 
              href="https://payhip.com/buy?link=icTVm" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-black text-sm text-center shadow-lg shadow-blue-600/30 transition-all flex items-center justify-center space-x-2"
            >
              <span>Get $27 Response Kit &rarr;</span>
              <span class="text-[10px] font-mono font-normal opacity-90">(SECURE ENCRYPTED CHECKOUT)</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ==================== 4. ARTICLES & FORENSIC FEED ==================== -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex items-center justify-between border-b border-sky-300/60 pb-4 mb-8">
          <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Standard Forensic Defense Articles</h2>
            <p class="text-xs font-medium text-slate-600 mt-1">Procedural deep dives, forensic guides, and rebuttal methods.</p>
          </div>
          <span class="text-xs font-mono font-bold text-blue-700 bg-white/80 border border-sky-200 px-3 py-1 rounded-full">
            {posts.length > 0 ? `${posts.length} Guides Available` : 'Active Feed'}
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Featured Anchor Guide (Always Visible) -->
          <article class="bg-white/95 rounded-2xl p-6 border-2 border-sky-300 shadow-md hover:shadow-xl hover:border-sky-500 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-3">
                <span class="font-bold text-blue-700 uppercase">CRISIS REBUTTAL</span>
                <span>5 MIN READ</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-2 leading-snug">
                How to Appeal a 100% Turnitin AI False Positive (The 48-Hour Technical Rebuttal)
              </h3>
              <p class="text-xs text-slate-600 mb-5 leading-relaxed">
                Step-by-step guide to defeating false Turnitin AI flags using continuous revision histories, raw session metadata, and statutory FERPA discovery.
              </p>
            </div>
            <a 
              href="/blog/markdown-style-guide" 
              class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 font-mono"
            >
              Read Article &rarr;
            </a>
          </article>

          <!-- Dynamic Markdown Posts from src/content/blog -->
          {posts.map((post) => (
            <article class="bg-white/95 rounded-2xl p-6 border-2 border-sky-200 shadow-md hover:shadow-xl hover:border-sky-400 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-3">
                  <span class="font-bold text-sky-700 uppercase">PROCEDURAL GUIDE</span>
                  <span>{post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString() : ''}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-2 leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-xs text-slate-600 mb-5 leading-relaxed">
                  {post.data.description}
                </p>
              </div>
              <a 
                href={`/blog/${post.slug || post.id}/`} 
                class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 font-mono"
              >
                Read Article &rarr;
              </a>
            </article>
          ))}

        </div>

      </div>
    </section>

  </main>

  <!-- ==================== 5. FOOTER ==================== -->
  <footer class="bg-white/80 backdrop-blur-md border-t border-sky-200 py-10 mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="p-6 sm:p-8 rounded-2xl bg-white/90 border border-sky-200 text-center leading-relaxed shadow-sm">
        
        <div class="flex flex-col items-center justify-center mb-5">
          <span class="text-lg sm:text-xl font-black tracking-tight block leading-tight mb-1">
            <span class="bg-[#ffff00] text-[#0040ff] px-3 py-0.5 rounded-md font-extrabold shadow-sm border border-yellow-300">TheStudentDocumentationLab</span><span class="text-[#0040ff] font-extrabold">™</span>
          </span>
          <span class="text-[11px] font-mono text-slate-600 block tracking-wider uppercase font-semibold">
            STUDENT DEFENSE ORGANIZATION SYSTEM
          </span>
          <span class="inline-block mt-2 px-2.5 py-0.5 rounded text-[10px] font-mono font-bold tracking-widest text-red-600 bg-red-50 border border-red-200 uppercase">
            NOT LEGAL ADVICE
          </span>
        </div>

        <p class="text-slate-800 text-xs sm:text-sm font-medium leading-relaxed max-w-3xl mx-auto mb-4">
          TheStudentDocumentationLab™ provides administrative record-keeping systems, evidence structuring tools, and educational self-help frameworks. We are not a law firm, nor do we offer formal legal representation or guaranteed academic outcomes. What we provide is administrative clarity: curated procedural data to help you articulate your rights under university bylaws.
        </p>

        <p class="text-slate-500 font-mono text-[11px]">&copy; 2026 TheStudentDocumentationLab™. All rights reserved.</p>
      </div>

    </div>
  </footer>

  <Analytics />
</body>
</html>